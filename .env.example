# Copia este archivo como .env y cambia los valores. El archivo .env nunca se sube al repositorio.

# Usuario dueño de la base de datos.
POSTGRES_USER=parkingapp
# Contraseña de ese usuario. En tu .env pon una propia.
POSTGRES_PASSWORD=cambia-esta-clave
# Nombre de la base de datos del MVP.
POSTGRES_DB=parkingapp
# Puerto de tu equipo donde queda PostgreSQL. Si ya usas el 5432, pon otro, por ejemplo 5433.
POSTGRES_PORT=5432
