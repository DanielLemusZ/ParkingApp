# Copia este archivo como .env y cambia los valores. El archivo .env nunca se sube al repositorio.

# Usuario dueño de la base de datos.
POSTGRES_USER=parkingapp
# Contraseña de ese usuario. En tu .env pon una propia.
POSTGRES_PASSWORD=cambia-esta-clave
# Nombre de la base de datos del MVP.
POSTGRES_DB=parkingapp
# Puerto de tu equipo donde queda PostgreSQL. Si ya usas el 5432, pon otro, por ejemplo 5433.
POSTGRES_PORT=5432
# Equipo donde corre PostgreSQL, para que la aplicación se conecte. Con Docker en tu equipo, 127.0.0.1.
# No uses localhost: en Windows se intenta primero IPv6 (::1), y cada conexión nueva espera varios segundos.
POSTGRES_HOST=127.0.0.1

# Puerto de tu equipo donde abre la aplicación cuando corre con Docker: http://localhost:8080.
# Si ya usas el 8080, pon otro. Con dotnet run la aplicación usa el 5288.
APP_PORT=8080

# Usuarios iniciales (F-10). La aplicación los crea al arrancar si no existen; si ya existen, no los cambia.
# La contraseña necesita al menos 8 caracteres, una mayúscula, una minúscula, un número y un símbolo.
# En tu .env pon contraseñas propias: estas son solo de ejemplo.
ADMIN_CORREO=admin@parkingapp.local
ADMIN_CONTRASENA=Cambia-Esta-Clave-1
OPERADOR_CORREO=operador@parkingapp.local
OPERADOR_CONTRASENA=Cambia-Esta-Clave-2

# Pasarela de pagos (#18): Simulada o PayU. Simulada: no usa internet y el operador aprueba o rechaza el pago.
# PayU: sandbox de PayU Latam, sin registro. Sin esta variable, la simulada.
PASARELA_PROVEEDOR=Simulada
# Solo con PayU. Credenciales de prueba PÚBLICAS del sandbox de PayU Latam para Colombia, tomadas de su documentación
# (developers.payulatam.com > Pruebas): no son secretas. Con una cuenta real de PayU, pon las tuyas solo en tu .env.
PAYU_MERCHANT_ID=508029
PAYU_ACCOUNT_ID=512321
PAYU_API_KEY=4Vj8eK4rloUd272L48hsrarnUA
PAYU_API_LOGIN=pRRXKOl8ikMmt9u
# Correo del comprador que pide PayU; la caja no conoce el del conductor.
PAYU_CORREO_COMPRADOR=conductor@parkingapp.local
# Si PayU falla, cobra con la simulada. Solo para la demo: en producción, false.
PASARELA_RESPALDO_SIMULADO=false
# Fallas seguidas de la pasarela después de las que la caja cobra solo en efectivo, y por cuántos minutos.
PASARELA_FALLAS_ANTES_DE_SOLO_EFECTIVO=3
PASARELA_MINUTOS_SIN_PASARELA=5
