@using ParkingApp.Web.Apariencia
<!DOCTYPE html>
<html lang="es" data-tema="@(modoOscuro ? PreferenciaDeTema.Oscuro : PreferenciaDeTema.Claro)">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="@(modoOscuro ? "dark" : "light")" />
    <base href="/" />
    <link rel="icon" type="image/svg+xml" href="@Assets["logo.svg"]" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["ParkingApp.Web.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="ModoDeLaPagina" />
</head>

<body>
    <Routes @rendermode="ModoDeLaPagina" ModoOscuro="modoOscuro" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
</body>

</html>

@code {
    // Cada página llega primero por HTTP. Si la página tiene [ExcludeFromInteractiveRouting] (las de cuenta), se
    // entrega estática: un formulario clásico que hace POST, cuya respuesta puede traer la cookie de sesión.
    // Las demás son interactivas (Blazor Server sobre SignalR), como antes.
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? ModoDeLaPagina => HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;

    // El tema se lee aquí, en la solicitud HTTP, porque el circuito interactivo no tiene acceso a las cookies.
    // Se pasa a Routes como parámetro, que sí viaja al circuito.
    private bool modoOscuro;

    protected override void OnInitialized()
    {
        modoOscuro = PreferenciaDeTema.EsOscuro(HttpContext.Request);
    }
}
