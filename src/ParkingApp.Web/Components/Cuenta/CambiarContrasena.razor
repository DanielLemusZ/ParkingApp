@page "/cuenta/cambiar-contrasena"
@attribute [Authorize]
@attribute [ExcludeFromInteractiveRouting]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using ParkingApp.Infraestructura.Identidad
@inject UserManager<Usuario> Usuarios
@inject SignInManager<Usuario> Sesiones

@* Estática por la misma razón que el inicio de sesión: al cambiar la contraseña se renueva la cookie. *@
<PageTitle>Cambiar contraseña</PageTitle>

@* Con sesión iniciada se conserva el encabezado; la tarjeta es la misma de Iniciar sesión (#71). *@
<TarjetaDeCuenta Titulo="Cambiar contraseña">
    @if (cambiada)
    {
        <MudAlert Severity="Severity.Success" Class="mb-4">La contraseña se cambió.</MudAlert>
    }

    @foreach (var error in errores)
    {
        <MudAlert Severity="Severity.Error" Class="mb-2">@error</MudAlert>
    }

    <EditForm Model="Entrada" method="post" OnValidSubmit="CambiarAsync" FormName="cambiar-contrasena">
        <DataAnnotationsValidator />

        <label class="cuenta-etiqueta" for="actual">Contraseña actual</label>
        <InputText id="actual" class="cuenta-campo" type="password" autocomplete="current-password" @bind-Value="Entrada.Actual" />
        <ValidationMessage For="() => Entrada.Actual" />

        <label class="cuenta-etiqueta" for="nueva">Contraseña nueva</label>
        <InputText id="nueva" class="cuenta-campo" type="password" autocomplete="new-password" @bind-Value="Entrada.Nueva" />
        <ValidationMessage For="() => Entrada.Nueva" />

        <label class="cuenta-etiqueta" for="confirmacion">Repite la contraseña nueva</label>
        <InputText id="confirmacion" class="cuenta-campo" type="password" autocomplete="new-password" @bind-Value="Entrada.Confirmacion" />
        <ValidationMessage For="() => Entrada.Confirmacion" />

        <button type="submit" class="cuenta-boton">Cambiar contraseña</button>
    </EditForm>
</TarjetaDeCuenta>

@code {
    private bool cambiada;
    private List<string> errores = new List<string>();

    // En una página estática, el HttpContext de la solicitud llega como parámetro en cascada.
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Sin un objeto nuevo como valor inicial, por la misma razón que en el inicio de sesión.
    [SupplyParameterFromForm]
    private DatosDelCambio Entrada { get; set; } = default!;

    protected override void OnInitialized()
    {
        Entrada ??= new();
    }

    private async Task CambiarAsync()
    {
        var usuario = await Usuarios.GetUserAsync(HttpContext.User);

        if (usuario is null)
        {
            errores = ["No se encontró el usuario de la sesión. Vuelve a iniciar sesión."];
            return;
        }

        // ChangePasswordAsync comprueba la contraseña actual, valida la nueva contra la política y guarda su hash.
        // También cambia el SecurityStamp del usuario, que invalida las sesiones abiertas con la contraseña vieja.
        var resultado = await Usuarios.ChangePasswordAsync(usuario, Entrada.Actual!, Entrada.Nueva!);

        if (!resultado.Succeeded)
        {
            errores = resultado.Errors.Select(error => error.Description).ToList();
            return;
        }

        // Por el cambio del SecurityStamp, la cookie actual quedaría vieja: se emite una nueva para no cerrar la sesión.
        await Sesiones.RefreshSignInAsync(usuario);
        cambiada = true;
        errores = [];
    }

    private sealed class DatosDelCambio
    {
        [Required(ErrorMessage = "Escribe tu contraseña actual")]
        [DataType(DataType.Password)]
        public string? Actual { get; set; }

        [Required(ErrorMessage = "Escribe la contraseña nueva")]
        [DataType(DataType.Password)]
        public string? Nueva { get; set; }

        [Compare(nameof(Nueva), ErrorMessage = "Las contraseñas nuevas no coinciden")]
        [DataType(DataType.Password)]
        public string? Confirmacion { get; set; }
    }
}
