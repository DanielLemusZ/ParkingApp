@inherits LayoutComponentBase
@using System.Security.Claims
@using ParkingApp.Web.Apariencia
@using ParkingApp.Web.Cuenta
@inject NavigationManager Navegacion

<MudThemeProvider Theme="TemaParkingApp.Tema" IsDarkMode="ModoOscuro" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    @* Encabezado de los mockups (#71): logo a la izquierda; correo, rol y cerrar sesión a la derecha; pestañas debajo. *@
    <header class="encabezado">
        <div class="barra">
            <a href="/" class="marca">
                <img src="logo.svg" alt="" width="36" height="36" />
                <span>ParkingApp</span>
            </a>
            <MudSpacer />

            @* El botón del tema es un formulario: la preferencia se guarda en una cookie, para que las páginas estáticas
               de cuenta también la lean. *@
            <form action="@PreferenciaDeTema.RutaCambiarTema" method="post" class="formulario-en-linea">
                <AntiforgeryToken />
                <input type="hidden" name="tema" value="@(ModoOscuro ? PreferenciaDeTema.Claro : PreferenciaDeTema.Oscuro)" />
                <input type="hidden" name="volverA" value="@DireccionActual" />
                <MudTooltip Text="@(ModoOscuro ? "Usar tema claro" : "Usar tema oscuro")">
                    <MudIconButton ButtonType="ButtonType.Submit" Size="Size.Small"
                                   Icon="@(ModoOscuro ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)"
                                   aria-label="@(ModoOscuro ? "Usar tema claro" : "Usar tema oscuro")" />
                </MudTooltip>
            </form>

            @* AuthorizeView muestra una parte u otra según haya sesión. "context.User" es el usuario de la cookie. *@
            <AuthorizeView>
                <Authorized>
                    <MudLink Href="/cuenta/cambiar-contrasena" Typo="Typo.body2" Color="Color.Default" Class="correo"
                             title="Cambiar contraseña">
                        @context.User.Identity?.Name
                    </MudLink>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">
                        @RolVisible(context.User)
                    </MudChip>
                    @* Cerrar sesión es un POST con token antiforgery: otro sitio no puede cerrar la sesión con un enlace. *@
                    <form action="@EndpointsDeCuenta.RutaCerrarSesion" method="post" class="formulario-en-linea">
                        <AntiforgeryToken />
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                                   StartIcon="@Icons.Material.Outlined.Logout">
                            Cerrar sesión
                        </MudButton>
                    </form>
                </Authorized>
                <NotAuthorized>
                    <MudButton Href="/cuenta/iniciar-sesion" Variant="Variant.Outlined" Size="Size.Small"
                               StartIcon="@Icons.Material.Outlined.Login">
                        Iniciar sesión
                    </MudButton>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        @* Las pestañas muestran solo las opciones del rol. Ocultar no es proteger: cada página tiene su [Authorize], y es
           eso lo que impide entrar escribiendo la dirección. *@
        <AuthorizeView Context="sesion">
            <nav class="pestanas" aria-label="Menú principal">
                @foreach (var opcion in MenuPorRol.Para(RolesDe(sesion.User)))
                {
                    @* Match="Prefix": /configuracion/tarifas también marca la pestaña Configuración. *@
                    <NavLink href="@opcion.Ruta" Match="NavLinkMatch.Prefix" class="pestana" ActiveClass="activa">
                        <MudIcon Icon="@IconoDe(opcion.Ruta)" Size="Size.Small" />
                        <span>@opcion.Texto</span>
                    </NavLink>
                }
            </nav>
        </AuthorizeView>
    </header>

    <main class="contenido">
        @Body
    </main>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // Viene de la cookie de preferencia, que App leyó en la solicitud HTTP.
    [CascadingParameter(Name = "ModoOscuro")]
    private bool ModoOscuro { get; set; } = true;

    // A dónde vuelve el usuario después de cambiar el tema: la misma página en la que estaba.
    private string DireccionActual => "/" + Navegacion.ToBaseRelativePath(Navegacion.Uri);

    // Los roles viajan en la cookie como claims de tipo "role"; Identity los agregó al iniciar sesión.
    private static IEnumerable<string> RolesDe(ClaimsPrincipal usuario)
    {
        return usuario.FindAll(ClaimTypes.Role).Select(claim => claim.Value);
    }

    // El chip muestra el rol con más permisos.
    private static string RolVisible(ClaimsPrincipal usuario)
    {
        return usuario.IsInRole(Roles.Administrador) ? Roles.Administrador : Roles.Operador;
    }

    // El ícono es asunto de la pantalla, no de la regla de roles: por eso vive aquí y no en MenuPorRol.
    private static string IconoDe(string ruta)
    {
        return ruta switch
        {
            "/carril" => Icons.Material.Outlined.Garage,
            "/caja" => Icons.Material.Outlined.PointOfSale,
            "/cupos" => Icons.Material.Outlined.LocalParking,
            "/historial" => Icons.Material.Outlined.Assessment,
            "/configuracion" => Icons.Material.Outlined.Settings,
            _ => Icons.Material.Outlined.ChevronRight,
        };
    }
}
