@using System.Globalization
@using ParkingApp.Aplicacion.Accesos
@using ParkingApp.Dominio.Accesos
@inject IServiceScopeFactory FabricaDeAlcances
@inject IDialogService Dialogos

@* Lecturas pendientes de la caja, como en el mockup (#71): una tarjeta por lectura con su motivo y Validar lectura. *@
<MudPaper Outlined="true" Class="pa-6">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h6">Lecturas pendientes</MudText>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                     Color="@(lecturas.Count > 0 ? Color.Warning : Color.Default)" Class="ma-0">
                @lecturas.Count
            </MudChip>
        </MudStack>
        <MudIconButton Icon="@Icons.Material.Outlined.Refresh" OnClick="CargarAsync" aria-label="Actualizar lecturas pendientes" />
    </MudStack>

    @if (lecturas.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="texto-tenue">No hay lecturas por validar.</MudText>
    }

    <MudStack Spacing="3">
        @foreach (var lectura in lecturas)
        {
            <div class="lectura-pendiente">
                <div class="datos">
                    @if (string.IsNullOrWhiteSpace(lectura.Placa))
                    {
                        <MudText Typo="Typo.subtitle1">Placa no reconocida</MudText>
                    }
                    else
                    {
                        <PlacaColombiana Placa="@lectura.Placa" Compacta="true" />
                    }
                    <MudText Typo="Typo.body2">
                        @NombreDeCarril(lectura.Tipo, lectura.Carril) · @lectura.FechaHora.ToString("HH:mm", CultureInfo.InvariantCulture)
                        @if (lectura.Confianza > 0)
                        {
                            <span> · Confianza @lectura.Confianza %</span>
                        }
                    </MudText>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ma-0"
                             Color="@(lectura.Motivo == MotivoDeLecturaPendiente.ConfianzaBaja ? Color.Warning : Color.Error)"
                             Icon="@(lectura.Motivo == MotivoDeLecturaPendiente.ConfianzaBaja ? Icons.Material.Outlined.WarningAmber : Icons.Material.Outlined.ErrorOutline)">
                        @NombreDeMotivo(lectura.Motivo)
                    </MudChip>
                </div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                           OnClick="@(() => RevisarAsync(lectura))">
                    Validar lectura
                </MudButton>
            </div>
        }
    </MudStack>

    @if (resultado is not null)
    {
        <FranjaDeResultado Class="mt-4" Severidad="@(resultado.AbreBarrera ? Severity.Success : Severity.Error)"
                           Titulo="@(resultado.AbreBarrera ? "Barrera abierta" : "Barrera cerrada")" Mensaje="@resultado.Motivo">
            @if (!resultado.AbreBarrera)
            {
                <div><small>La lectura ya quedó validada. Cuando se resuelva, vuelve a leer la placa en el carril.</small></div>
            }
        </FranjaDeResultado>
    }
</MudPaper>

@code {
    private IReadOnlyList<LecturaPorRevisar> lecturas = Array.Empty<LecturaPorRevisar>();
    private ResultadoDeValidarLectura? resultado;

    /// <summary>
    /// Avisa a la caja que se validó una lectura, porque un ingreso puede generar un cobro.
    /// </summary>
    [Parameter]
    public EventCallback AlValidar { get; set; }

    protected override Task OnInitializedAsync()
    {
        return CargarAsync();
    }

    private async Task RevisarAsync(LecturaPorRevisar lectura)
    {
        resultado = null;

        var parametros = new DialogParameters();
        parametros.Add(nameof(DialogoValidarLectura.Lectura), lectura);
        var opciones = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false };

        var dialogo = await Dialogos.ShowAsync<DialogoValidarLectura>("Validar lectura", parametros, opciones);
        var cierre = await dialogo.Result;

        // Se recarga también al cancelar: otro operador pudo validar la lectura mientras el diálogo estaba abierto.
        await CargarAsync();

        if (cierre?.Data is ResultadoDeValidarLectura validacion)
        {
            resultado = validacion;
            await AlValidar.InvokeAsync();
        }
    }

    private async Task CargarAsync()
    {
        await using var alcance = FabricaDeAlcances.CreateAsyncScope();
        var listar = alcance.ServiceProvider.GetRequiredService<ListarLecturasPendientes>();
        lecturas = await listar.EjecutarAsync();
    }

    private static string NombreDeCarril(TipoDeEvento tipo, int carril)
    {
        var nombre = tipo == TipoDeEvento.Ingreso ? "Entrada" : "Salida";
        return $"{nombre} {carril}";
    }

    private static string NombreDeMotivo(MotivoDeLecturaPendiente motivo)
    {
        return motivo switch
        {
            MotivoDeLecturaPendiente.ConfianzaBaja => "Baja confianza",
            MotivoDeLecturaPendiente.FormatoNoReconocido => "Formato no reconocido",
            _ => "No figura adentro",
        };
    }
}
