@using ParkingApp.Aplicacion.Accesos
@inject IServiceScopeFactory FabricaDeAlcances

@* Simula la cámara del carril: lee la placa de una foto. Si no puede, el operador la escribe a mano en el simulador. *@
<MudFileUpload @ref="subida" T="IBrowserFile" Accept=".jpg,.jpeg,.png" MaximumFileCount="1" FilesChanged="LeerAsync" Disabled="leyendo"
               Class="ma-0">
    <CustomContent>
        @* Recuadro punteado de los mockups (#71): todo el recuadro abre el selector de archivos. *@
        <button type="button" class="subir-imagen" disabled="@leyendo" @onclick="@context.OpenFilePickerAsync">
            <span class="icono-camara">
                @if (leyendo)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Outlined.PhotoCamera" />
                }
            </span>
            <span class="textos">
                <span class="titulo">@(leyendo ? "Leyendo la placa…" : "Subir imagen de la placa")</span>
                <span class="detalle">JPG o PNG · Cámara LPR Carril @Carril</span>
            </span>
        </button>
    </CustomContent>
</MudFileUpload>

@if (lectura is { Leida: false })
{
    <FranjaDeResultado Class="mt-3" Severidad="Severity.Warning" Titulo="@LeerPlacaDesdeImagen.Mensaje(lectura.Falla!.Value)"
                       Mensaje="Escribe la placa en el ingreso manual." />
}

@code {
    private MudFileUpload<IBrowserFile>? subida;
    private bool leyendo;
    private LecturaDeImagen? lectura;

    /// <summary>
    /// Número del carril, para el texto de la cámara.
    /// </summary>
    [Parameter]
    public int Carril { get; set; } = 1;

    /// <summary>
    /// Recibe cada resultado: la placa leída, o por qué no se pudo leer.
    /// </summary>
    [Parameter]
    public EventCallback<LecturaDeImagen> AlLeer { get; set; }

    private async Task LeerAsync(IBrowserFile? archivo)
    {
        if (archivo is null || leyendo)
        {
            return;
        }

        leyendo = true;
        lectura = null;

        try
        {
            // El archivo se lee directo a memoria y no se guarda en ningún lado.
            await using var alcance = FabricaDeAlcances.CreateAsyncScope();
            var leer = alcance.ServiceProvider.GetRequiredService<LeerPlacaDesdeImagen>();
            await using var contenido = archivo.OpenReadStream(maxAllowedSize: archivo.Size);
            lectura = await leer.EjecutarAsync(contenido, archivo.Size);
        }
        finally
        {
            leyendo = false;

            // Se olvida el archivo elegido: así el operador puede volver a subir la misma foto, por ejemplo tras un error.
            if (subida is not null)
            {
                await subida.ClearAsync();
            }
        }

        await AlLeer.InvokeAsync(lectura);
    }
}
