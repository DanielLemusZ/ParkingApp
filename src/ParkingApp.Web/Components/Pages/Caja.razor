@page "/caja"
@attribute [Authorize(Roles = Roles.OperadorOAdministrador)]
@using System.Globalization
@using ParkingApp.Aplicacion.Cobros
@using ParkingApp.Aplicacion.Pagos
@using ParkingApp.Dominio.Pagos
@using ParkingApp.Web.Components.Lecturas
@inject IServiceScopeFactory FabricaDeAlcances
@inject IPasarelaDePagos Pasarela
@inject NavigationManager Navegacion

<PageTitle>Caja</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Caja</MudText>
<PlacasPorRevisar AlValidar="CargarAsync" />
<MudText Class="mb-4">Vehículos con cobros pendientes. Elige uno para cobrar, en efectivo o con la pasarela, todo lo que debe desde que entró.</MudText>

<MudGrid>
    <MudItem xs="12" md="7">
        <MudPaper Class="pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                <MudTextField T="string" Label="Buscar por placa" @bind-Value="busqueda" Immediate="true"
                              DebounceInterval="300" OnDebounceIntervalElapsed="BuscarAsync"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Clearable="true" />
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="CargarAsync" aria-label="Actualizar" />
            </MudStack>
            <MudTable Items="deudas" Dense="true" Hover="true" T="DeudaDeVehiculo"
                      OnRowClick="@(fila => Elegir(fila.Item))" RowClassFunc="@ClaseDeFila">
                <HeaderContent>
                    <MudTh>Placa</MudTh>
                    <MudTh>Adentro desde</MudTh>
                    <MudTh>Cobros</MudTh>
                    <MudTh>Total</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Placa">@context.Placa</MudTd>
                    <MudTd DataLabel="Adentro desde">@Hora(context.AdentroDesde)</MudTd>
                    <MudTd DataLabel="Cobros">@context.Cobros.Count</MudTd>
                    <MudTd DataLabel="Total">@TextosDeCobro.Pesos(context.Total)</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText>No hay cobros pendientes@(string.IsNullOrWhiteSpace(busqueda) ? string.Empty : " con esa placa").</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="5">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" GutterBottom="true">Pago</MudText>
            @if (elegida is null)
            {
                <MudText>Elige un vehículo de la lista.</MudText>
            }
            else
            {
                <MudText><b>Placa:</b> @elegida.Placa</MudText>
                <MudText Class="mb-2"><b>Adentro desde:</b> @Hora(elegida.AdentroDesde)</MudText>
                <MudSimpleTable Dense="true" Class="mb-2">
                    <thead>
                        <tr>
                            <th>Día operativo</th>
                            <th>Motivo</th>
                            <th>Valor</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cobro in elegida.Cobros)
                        {
                            <tr>
                                <td>@cobro.DiaOperativo.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td>
                                <td>@TextosDeCobro.Motivo(cobro.Motivo, cobro.Franja, cobro.HoraDeIngreso)</td>
                                <td>@TextosDeCobro.Pesos(cobro.Valor)</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
                <MudText Typo="Typo.h5" Class="my-2">Total: @TextosDeCobro.Pesos(elegida.Total)</MudText>
                <MudRadioGroup T="MedioDePago" @bind-Value="medio" Class="mb-2">
                    <MudRadio Value="MedioDePago.Efectivo" Color="Color.Primary">Efectivo</MudRadio>
                    <MudRadio Value="MedioDePago.Pasarela" Color="Color.Primary" Disabled="!Pasarela.Disponible">
                        Pasarela (tarjeta, Nequi o QR)
                    </MudRadio>
                </MudRadioGroup>
                @if (!Pasarela.Disponible)
                {
                    <MudText Typo="Typo.body2" Color="Color.Warning" Class="mb-2">@TextosDeCobro.PasarelaNoDisponible</MudText>
                }
                @if (medio == MedioDePago.Pasarela && Pasarela.Disponible)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CreditCard"
                               Disabled="pagando" OnClick="CobrarConPasarelaAsync">
                        @(pagando ? "Abriendo la pasarela…" : $"Cobrar {TextosDeCobro.Pesos(elegida.Total)} con la pasarela")
                    </MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Payments"
                               Disabled="pagando" OnClick="PagarAsync">
                        @(pagando ? "Registrando…" : $"Registrar pago en efectivo de {TextosDeCobro.Pesos(elegida.Total)}")
                    </MudButton>
                }
            }
            @if (avisoDeLaPasarela is not null)
            {
                <MudAlert Class="mt-4" Severity="Severity.Warning">@avisoDeLaPasarela</MudAlert>
            }
            @if (resultado is not null)
            {
                <MudAlert Class="mt-4" Severity="@(resultado.Registrado ? Severity.Success : Severity.Warning)">
                    @resultado.Motivo
                    @if (resultado.Pago is not null)
                    {
                        <br />
                        <small>
                            @resultado.Pago.Placa · @Hora(resultado.Pago.FechaHora) · Ref. @resultado.Pago.Referencia
                        </small>
                    }
                </MudAlert>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private IReadOnlyList<DeudaDeVehiculo> deudas = Array.Empty<DeudaDeVehiculo>();
    private string? busqueda;
    private DeudaDeVehiculo? elegida;
    private ResultadoDePagoDeLaPlaca? resultado;
    private string? avisoDeLaPasarela;
    private bool pagando;
    private MedioDePago medio = MedioDePago.Efectivo;

    // Se genera al elegir el vehículo, no al pagar: un doble clic o un reintento mandan la misma referencia,
    // y la caja registra un solo pago.
    private Guid referencia;

    // El usuario de la sesión, que llega en cascada desde AddCascadingAuthenticationState.
    [CascadingParameter]
    private Task<AuthenticationState> EstadoDeSesion { get; set; } = default!;

    protected override Task OnInitializedAsync()
    {
        return CargarAsync();
    }

    private void Elegir(DeudaDeVehiculo? deuda)
    {
        if (deuda is null || elegida?.Placa == deuda.Placa)
        {
            return;
        }

        elegida = deuda;
        referencia = Guid.NewGuid();
        resultado = null;
        avisoDeLaPasarela = null;
    }

    // Prepara el pago y lleva al conductor a la página de la pasarela. Al terminar, la pasarela vuelve a
    // /caja/pasarela/retorno, que confirma la transacción y registra el pago.
    private async Task CobrarConPasarelaAsync()
    {
        if (elegida is null || pagando)
        {
            return;
        }

        pagando = true;
        resultado = null;
        avisoDeLaPasarela = null;

        try
        {
            await using var alcance = FabricaDeAlcances.CreateAsyncScope();
            var iniciar = alcance.ServiceProvider.GetRequiredService<IniciarPagoConPasarela>();
            var retorno = new Uri(Navegacion.ToAbsoluteUri("caja/pasarela/retorno").ToString());

            var inicio = await iniciar.EjecutarAsync(elegida.Placa, elegida.Total, referencia, retorno);

            if (inicio.Iniciado && inicio.UrlDePago is not null)
            {
                Navegacion.NavigateTo(inicio.UrlDePago.ToString(), forceLoad: inicio.UrlDePago.IsAbsoluteUri);
                return;
            }

            // Sin pasarela, la caja vuelve al efectivo; si cambió el total, se recarga el detalle.
            avisoDeLaPasarela = inicio.Motivo;
            medio = MedioDePago.Efectivo;
            await CargarAsync();
        }
        finally
        {
            pagando = false;
        }
    }

    private async Task PagarAsync()
    {
        if (elegida is null || pagando)
        {
            return;
        }

        pagando = true;

        try
        {
            await using var alcance = FabricaDeAlcances.CreateAsyncScope();
            var registrarPago = alcance.ServiceProvider.GetRequiredService<RegistrarPagoDeLaPlacaEnEfectivo>();
            // El operador del pago es el usuario de la sesión: su correo queda guardado en cada pago.
            var sesion = await EstadoDeSesion;
            var operador = sesion.User.Identity?.Name ?? throw new InvalidOperationException("No hay un usuario con sesión.");

            // Se manda el total que ve el operador: si cambió mientras tanto, el caso de uso no cobra y avisa el nuevo.
            resultado = await registrarPago.EjecutarAsync(elegida.Placa, elegida.Total, referencia, operador);

            // Se recarga con cualquier respuesta: si se pagó, la placa sale de la lista; si el total cambió, el panel
            // muestra el detalle nuevo para volver a cobrar.
            await CargarAsync();
        }
        finally
        {
            pagando = false;
        }
    }

    private Task BuscarAsync(string texto)
    {
        busqueda = texto;
        return CargarAsync();
    }

    private async Task CargarAsync()
    {
        await using var alcance = FabricaDeAlcances.CreateAsyncScope();
        var listar = alcance.ServiceProvider.GetRequiredService<ListarCobrosPendientes>();
        var pendientes = await listar.EjecutarAsync(busqueda);

        // Se juntan los cobros de cada placa: un vehículo debe todos sus cobros pendientes desde que entró.
        var cobrosPorPlaca = new Dictionary<string, List<CobroPendiente>>();

        foreach (var cobro in pendientes)
        {
            if (!cobrosPorPlaca.TryGetValue(cobro.Placa, out var cobrosDeLaPlaca))
            {
                cobrosDeLaPlaca = new List<CobroPendiente>();
                cobrosPorPlaca.Add(cobro.Placa, cobrosDeLaPlaca);
            }

            cobrosDeLaPlaca.Add(cobro);
        }

        // Una fila por vehículo, en el orden en que entraron, con sus cobros del día más antiguo al más reciente.
        var nuevas = new List<DeudaDeVehiculo>();

        foreach (var (placa, cobrosDeLaPlaca) in cobrosPorPlaca)
        {
            var adentroDesde = cobrosDeLaPlaca.Min(cobro => cobro.HoraDeIngreso);
            var porDia = cobrosDeLaPlaca.OrderBy(cobro => cobro.DiaOperativo).ToList();
            nuevas.Add(new DeudaDeVehiculo(placa, adentroDesde, porDia, porDia.Sum(cobro => cobro.Valor)));
        }

        deudas = nuevas.OrderBy(deuda => deuda.AdentroDesde).ToList();

        // El panel muestra siempre lo que se va a cobrar: si cambió lo que debe el vehículo elegido, se actualiza, y si
        // ya no debe nada, se cierra.
        if (elegida is not null)
        {
            elegida = deudas.FirstOrDefault(deuda => deuda.Placa == elegida.Placa);
        }
    }

    private string ClaseDeFila(DeudaDeVehiculo deuda, int indice)
    {
        return deuda.Placa == elegida?.Placa ? "mud-selected-item cursor-pointer" : "cursor-pointer";
    }

    private static string Hora(DateTimeOffset fechaHora)
    {
        return fechaHora.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }

    // Lo que debe un vehículo: sus cobros pendientes de todos los días operativos desde que entró.
    private sealed record DeudaDeVehiculo(string Placa, DateTimeOffset AdentroDesde, IReadOnlyList<CobroPendiente> Cobros, decimal Total);
}
