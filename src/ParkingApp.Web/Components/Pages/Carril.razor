@page "/carril"
@attribute [Authorize(Roles = Roles.OperadorOAdministrador)]
@using System.Globalization
@using ParkingApp.Aplicacion.Accesos
@using ParkingApp.Aplicacion.Cobros
@using ParkingApp.Dominio.Accesos
@using ParkingApp.Web.Components.Lecturas
@inject IServiceScopeFactory FabricaDeAlcances

<PageTitle>Carril</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">Carril</MudText>

<MudGrid>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" GutterBottom="true">Placa entrada</MudText>

            <MudSelect T="int" Label="Carril de entrada" @bind-Value="carril">
                <MudSelectItem T="int" Value="1">Carril 1</MudSelectItem>
                <MudSelectItem T="int" Value="2">Carril 2</MudSelectItem>
            </MudSelect>
            <SubirImagenDePlaca AlLeer="UsarLecturaDeEntradaAsync" />

            @* La placa y la confianza salen de la imagen; la confianza mínima la configura el Administrador. *@
            @if (escribirEntrada)
            {
                @* No hubo lectura: no hay confianza que mostrar. *@
                <LecturaManualDelCarril Sentido="TipoDeEvento.Ingreso" Carril="carril" Escribir="true" AlRegistrar="MostrarIngresoManual" />
            }
            else
            {
                <MudTextField T="string" Label="Placa" Value="placa" ReadOnly="true" Disabled="true" />
                <MudTextField T="string" Label="Confianza de la lectura" Value="@TextoDeConfianza(confianza)" ReadOnly="true" Disabled="true" />
            }
            <LecturaManualDelCarril Sentido="TipoDeEvento.Ingreso" Carril="carril" Pendiente="resultado?.LecturaPendiente"
                                    AlRegistrar="MostrarIngresoManual" />

            @if (resultado != null)
            {
                @if (resultado.AbreBarrera)
                {
                    <MudAlert Class="mt-4" Severity="Severity.Success" Icon="@Icons.Material.Filled.LockOpen">
                        <b>Barrera abierta</b>: @resultado.Motivo
                    </MudAlert>
                }
                else if (resultado.PendienteDeValidacion)
                {
                    <MudAlert Class="mt-4" Severity="Severity.Warning" Icon="@Icons.Material.Filled.Lock">
                        <b>Barrera cerrada</b>: @resultado.Motivo
                    </MudAlert>
                }
                else
                {
                    <MudAlert Class="mt-4" Severity="Severity.Error" Icon="@Icons.Material.Filled.Lock">
                        <b>Barrera cerrada</b>: @resultado.Motivo
                    </MudAlert>
                }

                @if (resultado.Ingreso != null)
                {
                    <MudSimpleTable Dense="true" Class="mt-2">
                        <tbody>
                            <tr><td>Placa</td><td>@resultado.Ingreso.Placa</td></tr>
                            <tr><td>Tipo de vehículo</td><td>@resultado.Ingreso.TipoDeVehiculo</td></tr>
                            <tr><td>Fecha y hora</td><td>@FormatearFecha(resultado.Ingreso.FechaHora)</td></tr>
                            <tr><td>Carril</td><td>@resultado.Ingreso.Carril</td></tr>
                            <tr><td>Confianza</td><td>@resultado.Ingreso.Confianza</td></tr>
                            @if (resultado.Ingreso.Cobro != null)
                            {
                                <tr><td>Cobro</td><td><b>@TextosDeCobro.Pesos(resultado.Ingreso.Cobro.Valor)</b> (@resultado.Ingreso.Cobro.Estado)</td></tr>
                                <tr><td>Franja</td><td>@resultado.Ingreso.Cobro.Franja</td></tr>
                                <tr><td>Día operativo</td><td>@resultado.Ingreso.Cobro.DiaOperativo.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</td></tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4">
            <MudText Typo="Typo.h6" GutterBottom="true">Placa salida</MudText>

            <MudSelect T="int" Label="Carril de salida" @bind-Value="carrilSalida">
                <MudSelectItem T="int" Value="1">Carril 1</MudSelectItem>
                <MudSelectItem T="int" Value="2">Carril 2</MudSelectItem>
            </MudSelect>
            <SubirImagenDePlaca AlLeer="UsarLecturaDeSalidaAsync" />

            @* La placa y la confianza salen de la imagen; la confianza mínima la configura el Administrador. *@
            @if (escribirSalida)
            {
                @* No hubo lectura: no hay confianza que mostrar. *@
                <LecturaManualDelCarril Sentido="TipoDeEvento.Salida" Carril="carrilSalida" Escribir="true" AlRegistrar="MostrarSalidaManual" />
            }
            else
            {
                <MudTextField T="string" Label="Placa" Value="placaSalida" ReadOnly="true" Disabled="true" />
                <MudTextField T="string" Label="Confianza de la lectura" Value="@TextoDeConfianza(confianzaSalida)" ReadOnly="true" Disabled="true" />
            }
            <LecturaManualDelCarril Sentido="TipoDeEvento.Salida" Carril="carrilSalida" Pendiente="resultadoSalida?.LecturaPendiente"
                                    AlRegistrar="MostrarSalidaManual" />

            @if (resultadoSalida != null)
            {
                @if (resultadoSalida.AbreBarrera)
                {
                    <MudAlert Class="mt-4" Severity="Severity.Success" Icon="@Icons.Material.Filled.LockOpen">
                        <b>Barrera abierta</b>: @resultadoSalida.Motivo
                    </MudAlert>
                }
                else if (resultadoSalida.PendienteDeValidacion)
                {
                    <MudAlert Class="mt-4" Severity="Severity.Warning" Icon="@Icons.Material.Filled.Lock">
                        <b>Barrera cerrada</b>: @resultadoSalida.Motivo
                    </MudAlert>
                }
                else
                {
                    <MudAlert Class="mt-4" Severity="Severity.Error" Icon="@Icons.Material.Filled.Lock">
                        <b>Barrera cerrada</b>: @resultadoSalida.Motivo
                    </MudAlert>
                }

                @if (resultadoSalida.Salida != null)
                {
                    <MudSimpleTable Dense="true" Class="mt-2">
                        <tbody>
                            <tr><td>Placa</td><td>@resultadoSalida.Salida.Placa</td></tr>
                            <tr><td>Tipo de vehículo</td><td>@resultadoSalida.Salida.TipoDeVehiculo</td></tr>
                            <tr><td>Fecha y hora</td><td>@FormatearFecha(resultadoSalida.Salida.FechaHora)</td></tr>
                            <tr><td>Carril</td><td>@resultadoSalida.Salida.Carril</td></tr>
                            <tr><td>Confianza</td><td>@resultadoSalida.Salida.Confianza</td></tr>
                        </tbody>
                    </MudSimpleTable>
                }
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private int carril = 1;
    private string? placa;
    private int? confianza;
    private bool escribirEntrada;
    private bool registrando;
    private ResultadoDeIngreso? resultado;

    private int carrilSalida = 1;
    private string? placaSalida;
    private int? confianzaSalida;
    private bool escribirSalida;
    private bool registrandoSalida;
    private ResultadoDeSalida? resultadoSalida;

    private async Task RegistrarIngresoAsync()
    {
        // Una segunda foto mientras se registra la primera no crea otro registro.
        if (registrando)
        {
            return;
        }

        registrando = true;

        try
        {
            // Cada registro usa su propio alcance: en Blazor Server la página vive mucho tiempo,
            // y el contexto de la base de datos no debe acumular datos entre un registro y otro.
            await using var alcance = FabricaDeAlcances.CreateAsyncScope();
            var registrarIngreso = alcance.ServiceProvider.GetRequiredService<RegistrarIngreso>();
            resultado = await registrarIngreso.EjecutarAsync(placa, confianza ?? 0, carril);
        }
        finally
        {
            registrando = false;
        }
    }

    private async Task RegistrarSalidaAsync()
    {
        if (registrandoSalida)
        {
            return;
        }

        registrandoSalida = true;

        try
        {
            await using var alcance = FabricaDeAlcances.CreateAsyncScope();
            var registrarSalida = alcance.ServiceProvider.GetRequiredService<RegistrarSalida>();
            resultadoSalida = await registrarSalida.EjecutarAsync(placaSalida, confianzaSalida ?? 0, carrilSalida);
        }
        finally
        {
            registrandoSalida = false;
        }
    }

    // Con la placa leída se registra el ingreso, como lo haría la cámara. Si la foto no se pudo leer, se habilita
    // escribir la placa; si la lectura no alcanza el umbral, el registro la deja pendiente para validarla.
    private async Task UsarLecturaDeEntradaAsync(LecturaDeImagen lectura)
    {
        resultado = null;
        escribirEntrada = !lectura.Leida;
        placa = lectura.Leida ? lectura.Placa : null;
        confianza = lectura.Leida ? lectura.Confianza : null;

        if (lectura.Leida)
        {
            await RegistrarIngresoAsync();
        }
    }

    private async Task UsarLecturaDeSalidaAsync(LecturaDeImagen lectura)
    {
        resultadoSalida = null;
        escribirSalida = !lectura.Leida;
        placaSalida = lectura.Leida ? lectura.Placa : null;
        confianzaSalida = lectura.Leida ? lectura.Confianza : null;

        if (lectura.Leida)
        {
            await RegistrarSalidaAsync();
        }
    }

    // La placa validada o escrita a mano ya siguió el flujo del carril: solo se muestra el resultado.
    private void MostrarIngresoManual(ResultadoDeValidarLectura validada)
    {
        escribirEntrada = false;
        resultado = new ResultadoDeIngreso(validada.AbreBarrera, validada.Motivo, validada.Ingreso);

        if (validada.Ingreso is not null)
        {
            placa = validada.Ingreso.Placa;
            confianza = validada.Ingreso.Confianza;
        }
    }

    private void MostrarSalidaManual(ResultadoDeValidarLectura validada)
    {
        escribirSalida = false;
        resultadoSalida = new ResultadoDeSalida(validada.AbreBarrera, validada.Motivo, validada.Salida);

        if (validada.Salida is not null)
        {
            placaSalida = validada.Salida.Placa;
            confianzaSalida = validada.Salida.Confianza;
        }
    }

    private static string TextoDeConfianza(int? valor)
    {
        return valor is null ? string.Empty : $"{valor} %";
    }

    private static string FormatearFecha(DateTimeOffset fechaHora)
    {
        return fechaHora.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture);
    }
}
