@page "/carril"
@attribute [Authorize(Roles = Roles.OperadorOAdministrador)]
@using System.Globalization
@using ParkingApp.Aplicacion.Accesos
@using ParkingApp.Aplicacion.Cobros
@using ParkingApp.Aplicacion.Configuracion
@using ParkingApp.Dominio.Accesos
@using ParkingApp.Web.Components.Lecturas
@inject IServiceScopeFactory FabricaDeAlcances

<PageTitle>Monitoreo de acceso</PageTitle>

@* Distribución del mockup del carril (#71): paneles de entrada y salida, cada uno con su barrera, la placa leída, el
   simulador y el resultado. Solo cambia la presentación: los casos de uso son los mismos. *@
<div class="encabezado-pagina">
    <MudText Typo="Typo.h4">Monitoreo de acceso</MudText>
    @if (sede is not null)
    {
        <MudStack Row="true" Spacing="2">
            <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Outlined.DirectionsCar"
                     Color="@ColorDeOcupacion(sede.Ocupacion.Carros, sede.CupoCarros)">
                Carros @sede.Ocupacion.Carros/@sede.CupoCarros@(sede.Ocupacion.Carros >= sede.CupoCarros ? " · LLENO" : string.Empty)
            </MudChip>
            <MudChip T="string" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Outlined.TwoWheeler"
                     Color="@ColorDeOcupacion(sede.Ocupacion.Motos, sede.CupoMotos)">
                Motos @sede.Ocupacion.Motos/@sede.CupoMotos@(sede.Ocupacion.Motos >= sede.CupoMotos ? " · LLENO" : string.Empty)
            </MudChip>
        </MudStack>
    }
</div>

<div class="carriles">
    @* ---------- Entrada ---------- *@
    <section class="panel">
        <div class="cabecera-panel">
            <MudText Typo="Typo.h5" Color="Color.Info">Entrada</MudText>
            <MudSelect T="int" @bind-Value="carril" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                       Class="selector-carril" aria-label="Carril de entrada">
                <MudSelectItem T="int" Value="1">Carril 1</MudSelectItem>
                <MudSelectItem T="int" Value="2">Carril 2</MudSelectItem>
            </MudSelect>
            <MudSpacer />
            <IndicadorDeBarrera Abierta="@(resultado?.AbreBarrera ?? false)" />
        </div>

        <SubirImagenDePlaca Carril="carril" AlLeer="UsarLecturaDeEntradaAsync" />

        @* La placa y la confianza salen de la imagen; la confianza mínima la configura el Administrador. *@
        <div class="lectura">
            @if (placa is null)
            {
                <MudText Typo="Typo.body2" Class="texto-tenue">Sin placa leída.</MudText>
            }
            else
            {
                <PlacaColombiana Placa="@placa" />
            }
            @if (confianza is not null)
            {
                <ChipDeConfianza Confianza="confianza.Value" PorValidar="@(resultado?.PendienteDeValidacion == true)" />
            }
        </div>

        <LecturaManualDelCarril Sentido="TipoDeEvento.Ingreso" Carril="carril" Pendiente="resultado?.LecturaPendiente"
                                AlRegistrar="MostrarIngresoManual" />

        <MudExpansionPanels Outlined="true" Elevation="0" Class="mt-4">
            <MudExpansionPanel @bind-Expanded="simuladorEntradaAbierto">
                <TitleContent>
                    <div class="titulo-simulador">
                        <MudIcon Icon="@Icons.Material.Outlined.Keyboard" Size="Size.Small" />
                        <span>Ingreso manual (simulador)</span>
                    </div>
                </TitleContent>
                <ChildContent>
                    @if (escribirEntrada)
                    {
                        @* No hubo lectura: no hay confianza que mostrar. *@
                        <LecturaManualDelCarril Sentido="TipoDeEvento.Ingreso" Carril="carril" Escribir="true" AlRegistrar="MostrarIngresoManual" />
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Class="texto-tenue">
                            Se habilita cuando la foto de la placa no se puede leer.
                        </MudText>
                    }
                </ChildContent>
            </MudExpansionPanel>
        </MudExpansionPanels>

        @if (resultado != null)
        {
            <FranjaDeResultado Class="mt-4" Severidad="@SeveridadDe(resultado.AbreBarrera, resultado.PendienteDeValidacion)"
                               Titulo="@(resultado.AbreBarrera ? "Barrera abierta" : "Barrera cerrada")" Mensaje="@resultado.Motivo" />

            @if (resultado.Ingreso != null)
            {
                <MudText Typo="Typo.body2" Class="texto-tenue mt-2">@DetalleDe(resultado.Ingreso)</MudText>
            }
        }
    </section>

    @* ---------- Salida ---------- *@
    <section class="panel">
        <div class="cabecera-panel">
            <MudText Typo="Typo.h5" Color="Color.Info">Salida</MudText>
            <MudSelect T="int" @bind-Value="carrilSalida" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                       Class="selector-carril" aria-label="Carril de salida">
                <MudSelectItem T="int" Value="1">Carril 1</MudSelectItem>
                <MudSelectItem T="int" Value="2">Carril 2</MudSelectItem>
            </MudSelect>
            <MudSpacer />
            <IndicadorDeBarrera Abierta="@(resultadoSalida?.AbreBarrera ?? false)" />
        </div>

        <SubirImagenDePlaca Carril="carrilSalida" AlLeer="UsarLecturaDeSalidaAsync" />

        <div class="lectura">
            @if (placaSalida is null)
            {
                <MudText Typo="Typo.body2" Class="texto-tenue">Sin placa leída.</MudText>
            }
            else
            {
                <PlacaColombiana Placa="@placaSalida" />
            }
            @if (confianzaSalida is not null)
            {
                <ChipDeConfianza Confianza="confianzaSalida.Value" PorValidar="@(resultadoSalida?.PendienteDeValidacion == true)" />
            }
        </div>

        <LecturaManualDelCarril Sentido="TipoDeEvento.Salida" Carril="carrilSalida" Pendiente="resultadoSalida?.LecturaPendiente"
                                AlRegistrar="MostrarSalidaManual" />

        <MudExpansionPanels Outlined="true" Elevation="0" Class="mt-4">
            <MudExpansionPanel @bind-Expanded="simuladorSalidaAbierto">
                <TitleContent>
                    <div class="titulo-simulador">
                        <MudIcon Icon="@Icons.Material.Outlined.Keyboard" Size="Size.Small" />
                        <span>Ingreso manual (simulador)</span>
                    </div>
                </TitleContent>
                <ChildContent>
                    @if (escribirSalida)
                    {
                        <LecturaManualDelCarril Sentido="TipoDeEvento.Salida" Carril="carrilSalida" Escribir="true" AlRegistrar="MostrarSalidaManual" />
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Class="texto-tenue">
                            Se habilita cuando la foto de la placa no se puede leer.
                        </MudText>
                    }
                </ChildContent>
            </MudExpansionPanel>
        </MudExpansionPanels>

        @if (resultadoSalida != null)
        {
            <FranjaDeResultado Class="mt-4" Severidad="@SeveridadDe(resultadoSalida.AbreBarrera, resultadoSalida.PendienteDeValidacion)"
                               Titulo="@(resultadoSalida.AbreBarrera ? "Barrera abierta" : "Barrera cerrada")" Mensaje="@resultadoSalida.Motivo" />

            @if (resultadoSalida.Salida != null)
            {
                <MudText Typo="Typo.body2" Class="texto-tenue mt-2">@DetalleDe(resultadoSalida.Salida)</MudText>
            }
        }
    </section>
</div>

@code {
    private int carril = 1;
    private string? placa;
    private int? confianza;
    private bool escribirEntrada;
    private bool simuladorEntradaAbierto;
    private bool registrando;
    private ResultadoDeIngreso? resultado;

    private int carrilSalida = 1;
    private string? placaSalida;
    private int? confianzaSalida;
    private bool escribirSalida;
    private bool simuladorSalidaAbierto;
    private bool registrandoSalida;
    private ResultadoDeSalida? resultadoSalida;

    // Cupos y ocupación de la sede (#19), para los chips del encabezado.
    private DatosDeConfiguracionSede? sede;

    protected override async Task OnInitializedAsync()
    {
        await CargarOcupacionAsync();
    }

    private async Task CargarOcupacionAsync()
    {
        await using var alcance = FabricaDeAlcances.CreateAsyncScope();
        var configurarSede = alcance.ServiceProvider.GetRequiredService<ConfigurarSede>();
        sede = await configurarSede.ConsultarAsync();
    }

    private async Task RegistrarIngresoAsync()
    {
        // Una segunda foto mientras se registra la primera no crea otro registro.
        if (registrando)
        {
            return;
        }

        registrando = true;

        try
        {
            // Cada registro usa su propio alcance: en Blazor Server la página vive mucho tiempo,
            // y el contexto de la base de datos no debe acumular datos entre un registro y otro.
            await using var alcance = FabricaDeAlcances.CreateAsyncScope();
            var registrarIngreso = alcance.ServiceProvider.GetRequiredService<RegistrarIngreso>();
            resultado = await registrarIngreso.EjecutarAsync(placa, confianza ?? 0, carril);
        }
        finally
        {
            registrando = false;
        }

        await CargarOcupacionAsync();
    }

    private async Task RegistrarSalidaAsync()
    {
        if (registrandoSalida)
        {
            return;
        }

        registrandoSalida = true;

        try
        {
            await using var alcance = FabricaDeAlcances.CreateAsyncScope();
            var registrarSalida = alcance.ServiceProvider.GetRequiredService<RegistrarSalida>();
            resultadoSalida = await registrarSalida.EjecutarAsync(placaSalida, confianzaSalida ?? 0, carrilSalida);
        }
        finally
        {
            registrandoSalida = false;
        }

        await CargarOcupacionAsync();
    }

    // Con la placa leída se registra el ingreso, como lo haría la cámara. Si la foto no se pudo leer, se abre el
    // simulador para escribir la placa; si la lectura no alcanza el umbral, el registro la deja pendiente para validarla.
    private async Task UsarLecturaDeEntradaAsync(LecturaDeImagen lectura)
    {
        resultado = null;
        escribirEntrada = !lectura.Leida;
        simuladorEntradaAbierto = escribirEntrada;
        placa = lectura.Leida ? lectura.Placa : null;
        confianza = lectura.Leida ? lectura.Confianza : null;

        if (lectura.Leida)
        {
            await RegistrarIngresoAsync();
        }
    }

    private async Task UsarLecturaDeSalidaAsync(LecturaDeImagen lectura)
    {
        resultadoSalida = null;
        escribirSalida = !lectura.Leida;
        simuladorSalidaAbierto = escribirSalida;
        placaSalida = lectura.Leida ? lectura.Placa : null;
        confianzaSalida = lectura.Leida ? lectura.Confianza : null;

        if (lectura.Leida)
        {
            await RegistrarSalidaAsync();
        }
    }

    // La placa validada o escrita a mano ya siguió el flujo del carril: solo se muestra el resultado.
    private async Task MostrarIngresoManual(ResultadoDeValidarLectura validada)
    {
        escribirEntrada = false;
        simuladorEntradaAbierto = false;
        resultado = new ResultadoDeIngreso(validada.AbreBarrera, validada.Motivo, validada.Ingreso);

        if (validada.Ingreso is not null)
        {
            placa = validada.Ingreso.Placa;
            confianza = validada.Ingreso.Confianza;
        }

        await CargarOcupacionAsync();
    }

    private async Task MostrarSalidaManual(ResultadoDeValidarLectura validada)
    {
        escribirSalida = false;
        simuladorSalidaAbierto = false;
        resultadoSalida = new ResultadoDeSalida(validada.AbreBarrera, validada.Motivo, validada.Salida);

        if (validada.Salida is not null)
        {
            placaSalida = validada.Salida.Placa;
            confianzaSalida = validada.Salida.Confianza;
        }

        await CargarOcupacionAsync();
    }

    // Verde si abre; ámbar si la lectura quedó por validar; rojo si se rechazó.
    private static Severity SeveridadDe(bool abreBarrera, bool pendienteDeValidacion)
    {
        if (abreBarrera)
        {
            return Severity.Success;
        }

        return pendienteDeValidacion ? Severity.Warning : Severity.Error;
    }

    private static Color ColorDeOcupacion(int ocupacion, int cupo)
    {
        return ocupacion >= cupo ? Color.Error : Color.Default;
    }

    private static string DetalleDe(IngresoRegistrado ingreso)
    {
        var detalle = $"{ingreso.TipoDeVehiculo} · {FormatearFecha(ingreso.FechaHora)} · Carril {ingreso.Carril}";

        if (ingreso.Cobro is not null)
        {
            detalle += $" · Cobro {ingreso.Cobro.Franja.ToString().ToLowerInvariant()} {TextosDeCobro.Pesos(ingreso.Cobro.Valor)}"
                + $" ({ingreso.Cobro.Estado}) · Día operativo {ingreso.Cobro.DiaOperativo.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}";
        }

        return detalle;
    }

    private static string DetalleDe(SalidaRegistrada salida)
    {
        return $"{salida.TipoDeVehiculo} · {FormatearFecha(salida.FechaHora)} · Carril {salida.Carril}";
    }

    private static string FormatearFecha(DateTimeOffset fechaHora)
    {
        return fechaHora.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture);
    }
}
