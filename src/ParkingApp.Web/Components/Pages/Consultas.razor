@page "/consultas"
@using System.Globalization
@using ParkingApp.Aplicacion.Cobros
@using ParkingApp.Aplicacion.Reportes
@using ParkingApp.Dominio.Cobros
@inject IServicioConsultas ServicioConsultas

<MudText Typo="Typo.h4" GutterBottom="true">Consultar ingresos, salidas y cobros</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="3">
    <MudGrid>
        <MudItem xs="12" sm="3">
            <MudTextField @bind-Value="Filtros.Placa" Label="Placa" Variant="Variant.Outlined" Clearable="true" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudDatePicker @bind-Date="Filtros.FechaInicio" Label="Fecha inicial" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudDatePicker @bind-Date="Filtros.FechaFin" Label="Fecha final" Variant="Variant.Outlined" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudSelect T="EstadoDeCobro?" @bind-Value="Filtros.EstadoCobro" Label="Estado del cobro" Variant="Variant.Outlined" Clearable="true">
                <MudSelectItem T="EstadoDeCobro?" Value="@(EstadoDeCobro.Pendiente)">Pendiente</MudSelectItem>
                <MudSelectItem T="EstadoDeCobro?" Value="@(EstadoDeCobro.Pagado)">Pagado</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="BuscarDatos">Filtrar</MudButton>
            @if (!string.IsNullOrEmpty(MensajeError))
            {
                <MudText Color="Color.Error" Class="ml-4">@MensajeError</MudText>
            }
        </MudItem>
    </MudGrid>
</MudPaper>

<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-6">
    <MudTabPanel Text="Accesos (ingresos y salidas)">
        <MudDataGrid Items="@ListaAccesos" Dense="true" Hover="true">
            <Columns>
                <PropertyColumn Property="x => x.Placa" Title="Placa" />
                <PropertyColumn Property="x => x.TipoVehiculo" Title="Tipo de vehículo" />
                <PropertyColumn Property="x => x.TipoEvento" Title="Evento" />
                <TemplateColumn Title="Fecha y hora">
                    <CellTemplate>
                        @context.Item.FechaHora.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture)
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Carril" Title="Carril" />
                <TemplateColumn Title="Lectura manual">
                    <CellTemplate>
                        @(context.Item.EsLecturaManual ? "Sí" : "No")
                    </CellTemplate>
                </TemplateColumn>
            </Columns>
            <NoRecordsContent>
                <MudText>No hay resultados</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudDataGridPager T="EventoAccesoDto" RowsPerPageString="Filas por página:" InfoFormat="{first_item}-{last_item} de {all_items}" />
            </PagerContent>
        </MudDataGrid>
    </MudTabPanel>

    <MudTabPanel Text="Cobros">
        <MudDataGrid Items="@ListaCobros" Dense="true" Hover="true">
            <Columns>
                <PropertyColumn Property="x => x.Placa" Title="Placa" />
                <TemplateColumn Title="Día operativo">
                    <CellTemplate>
                        @context.Item.DiaOperativo.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Franja" Title="Franja" />
                <TemplateColumn Title="Valor">
                    <CellTemplate>
                        @TextosDeCobro.Pesos(context.Item.Valor)
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.Estado" Title="Estado" />
            </Columns>
            <NoRecordsContent>
                <MudText>No hay resultados</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudDataGridPager T="CobroConsultaDto" RowsPerPageString="Filas por página:" InfoFormat="{first_item}-{last_item} de {all_items}" />
            </PagerContent>
        </MudDataGrid>
    </MudTabPanel>
</MudTabs>

@code {
    private FiltrosConsultaDto Filtros = new FiltrosConsultaDto();
    private List<EventoAccesoDto> ListaAccesos = new();
    private List<CobroConsultaDto> ListaCobros = new();
    private string MensajeError = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await BuscarDatos();
    }

    private async Task BuscarDatos()
    {
        MensajeError = string.Empty;

        try
        {
            ListaAccesos = await ServicioConsultas.ConsultarAccesosAsync(Filtros);
            ListaCobros = await ServicioConsultas.ConsultarCobrosAsync(Filtros);
        }
        catch (ArgumentException ex)
        {
            // La fecha inicial es posterior a la final: se muestra el mensaje y se vacían las tablas.
            MensajeError = ex.Message;
            ListaAccesos.Clear();
            ListaCobros.Clear();
        }
    }
}
